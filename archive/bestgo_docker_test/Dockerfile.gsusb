# Userspace-gs_usb BESTGO test -- talks to the SH-C31G via libusb, NOT the
# kernel SocketCAN/gs_usb driver (which receives 0 frames for this FDCAN
# adapter on HAOS). Reuses the decoder from bestgo_logtest.py.
#
# Build (on the HA box, in the SSH add-on shell):
#   sudo docker build -t bestgo-gsusb-test -f Dockerfile.gsusb /share/bestgo-test
#
# Run -- real bus. Needs privileged (to unbind the kernel driver via /sys and
# to let libusb claim the USB device); does NOT use --network host:
#   sudo docker run --rm --privileged -v /dev/bus/usb:/dev/bus/usb bestgo-gsusb-test 15
#
# Run -- dummy (no hardware, synthetic frames, decoder sanity check):
#   sudo docker run --rm bestgo-gsusb-test -dummy 12
FROM python:3.12-slim

# pyusb + gs-usb for the userspace transport; libusb-package bundles the
# libusb shared library so no apt install of libusb is needed (same set the
# proven PC tools use). Versions pinned to CANbus_data/requirements.txt.
RUN pip install --no-cache-dir \
        pyusb==1.3.1 \
        gs-usb==0.3.1 \
        libusb-package==1.0.26.3

WORKDIR /app
COPY bestgo_logtest.py bestgo_gsusb_test.py entrypoint_gsusb.sh /app/
RUN chmod +x /app/entrypoint_gsusb.sh

ENTRYPOINT ["/app/entrypoint_gsusb.sh"]
